{
  "name": "causal-dag-explorer-mcp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"cross-env DAY_DIAGRAM_WEB_ORIGIN=http://127.0.0.1:5173 tsx watch src/server/index.ts\"",
    "build": "tsc -p tsconfig.node.json && vite build",
    "start": "node dist/node/server/index.js",
    "start:mcp": "node dist/node/mcp/index.js",
    "seed:example": "node scripts/seed-example.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "test:release": "node scripts/release-check.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "verify": "pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:mcp && pnpm test:release && pnpm test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reactflow": "^11.11.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
