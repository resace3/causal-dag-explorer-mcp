# Copy to `.env`. This file is git-ignored — never commit a real token.

# ---------------------------------------------------------------------------
# Locale
# ---------------------------------------------------------------------------
# IANA timezone used to determine which local calendar day "yesterday" was.
# Overrides `timezone:` in config.yaml.
LOCAL_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Data mode
# ---------------------------------------------------------------------------
# true  -> deterministic synthetic data, no credentials needed (default)
# false -> read from Home Assistant and the configured wearable provider
USE_MOCK_DATA=true
MOCK_DATA_SEED=42

# Overrides `wearable.provider` in config.yaml when USE_MOCK_DATA=false.
# One of: mock, json_file
# WEARABLE_PROVIDER=json_file

# ---------------------------------------------------------------------------
# Home Assistant (only read when USE_MOCK_DATA=false)
# ---------------------------------------------------------------------------
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_SECONDS=15
# Set to false only for a self-signed certificate on your own network.
HOME_ASSISTANT_VERIFY_SSL=true

# ---------------------------------------------------------------------------
# ActivityWatch (only read when USE_MOCK_DATA=false)
# ---------------------------------------------------------------------------
# The local ActivityWatch server. Unauthenticated and loopback-only, so there is
# no credential; set this only if it does not listen on the default port.
# ACTIVITYWATCH_URL=http://localhost:5600
# ACTIVITYWATCH_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Local servers — bound to the loopback interface, never exposed publicly
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite lives at $DATA_DIR/yesterday.sqlite3. `make clean-data` removes it.
# DATA_DIR=./data
# CONFIG_PATH=./config.yaml
